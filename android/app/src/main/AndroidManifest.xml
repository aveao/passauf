<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.NFC" />
    <!-- Reader mode is the whole app, so a device without NFC cannot run it.
         Lint would rather this were optional, but there is nothing to fall back
         to: without a reader there is no document to read. -->
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="true"
        tools:ignore="UnnecessaryRequiredFeature" />

    <!-- Reading the MRZ off the document instead of typing it. Optional in every
         sense: the permission is only asked for when the scanner is opened, and
         declining it costs nothing, because the fields can still be entered by
         hand. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- This app must never hold INTERNET, and saying so takes work rather than
         silence. ML Kit brings in com.google.android.datatransport:transport-backend-cct,
         Google's telemetry pipeline, which declares INTERNET and ACCESS_NETWORK_STATE
         of its own accord, and the manifest merger would fold both into the APK
         without a word.

         Removing them here is what makes "nothing leaves the device" enforced rather
         than promised: text recognition runs against a model bundled into the APK and
         needs no network, and with the permissions gone anything that tries anyway is
         refused by the system rather than trusted not to.

         If either line ever disappears, check the merged manifest under
         app/build/outputs/logs/manifest-merger-*-report.txt before assuming a
         dependency stopped asking. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />


    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Passauf">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Passauf">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets the share sheet read files out of the app's own storage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
