<?xml version="1.0" encoding="utf-8"?>
<!--
  The filler character of a machine readable zone, two rows of it.

  Every travel document prints `<` by the dozen and nothing else prints it at all,
  which is more than a passport book can say: a book with a wireless mark beside it
  is also several banking apps and every other NFC reader on the phone.

  Strokes rather than a filled shape with detail painted on top, so that the icon is
  its own silhouette. Android tints the monochrome layer a single colour for a themed
  icon, and anything drawn in a second colour over a filled shape — which is what this
  replaces — disappears into it, leaving a blank rectangle.

  Everything sits inside the 66dp circle centred on the 108dp canvas, which is the
  area that survives every mask a launcher might apply.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M46,34 L38,42 L46,50 M58,34 L50,42 L58,50 M70,34 L62,42 L70,50
                          M46,58 L38,66 L46,74 M58,58 L50,66 L58,74 M70,58 L62,66 L70,74" />
</vector>
