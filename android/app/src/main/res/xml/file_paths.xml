<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!--
      A read's files live under the cache, not the app's data directory: they
      are disposable, the system may reclaim them, and nothing here should
      outlive the user's interest in it. This is the only thing shareable.
    -->
    <cache-path
        name="documents"
        path="documents/" />
</paths>
