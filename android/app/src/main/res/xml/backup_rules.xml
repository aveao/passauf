<?xml version="1.0" encoding="utf-8"?>
<!--
  The pre-Android-12 form of data_extraction_rules.xml. Nothing a read produces
  is backed up; allowBackup is false as well, so this is belt and braces.
-->
<full-backup-content>
    <exclude
        domain="root"
        path="." />
    <exclude
        domain="file"
        path="." />
    <exclude
        domain="database"
        path="." />
    <exclude
        domain="sharedpref"
        path="." />
</full-backup-content>
